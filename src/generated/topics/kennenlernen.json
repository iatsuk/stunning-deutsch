     "who": "A",
     "de": "Hallo! Ich bin Anna. Und wer bist du?",
     "ru": "Привет! Я Анна. А ты кто?",
     "audio": "audio/00277273b4cc.m4a"
    },
    {
     "who": "M",
     "de": "Hallo, Anna! Ich heiße Marco.",
     "ru": "Привет, Анна! Меня зовут Марко.",
