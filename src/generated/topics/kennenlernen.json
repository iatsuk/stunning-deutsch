    {
     "who": "A",
     "de": "Woher kommst du, Marco?",
     "ru": "Откуда ты, Марко?",
     "audio": "audio/761c149bdd1d.m4a"
    },
    {
     "who": "M",
     "de": "Ich komme aus Italien, aus Rom. Und du?",
     "ru": "Я из Италии, из Рима. А ты?",
     "audio": "audio/a2b9d6ddf034.m4a"
    },
    {
     "who": "A",
     "de": "Ich komme aus Polen. Aber ich wohne jetzt hier in Leipzig.",
     "ru": "Я из Польши. Но сейчас я живу здесь, в Лейпциге.",
     "audio": "audio/dce373ac7947.m4a"
    },
    {
     "who": "M",
     "de": "Ich wohne auch in Leipzig! Welche Sprachen sprichst du?",
     "ru": "Я тоже живу в Лейпциге! На каких языках ты говоришь?",
     "audio": "audio/6d555fdf1798.m4a"
    },
    {
     "who": "A",
     "de": "Polnisch, Englisch und ein bisschen Deutsch.",
     "ru": "На польском, английском и немного на немецком.",
     "audio": "audio/4fd6cf74decb.m4a"
    },
    {
     "who": "M",
     "de": "Ich auch – ein bisschen!",
     "ru": "Я тоже — немного!",
     "audio": "audio/c521410179f9.m4a"
    }
   ]
